SELECT 
    b.category,
    SUM(rd.quantity) AS total_rented,
    SUM(rd.quantity * b.rent_price_per_day) AS revenue

FROM rental_details rd

JOIN books b
ON rd.book_id = b.id

GROUP BY b.category

ORDER BY revenue DESC;

ALTER TABLE rentals
ADD created_at DATETIME DEFAULT GETDATE();


SELECT 
    b.category,
    SUM(rd.quantity) AS total_rented,
    SUM(rd.quantity * b.rent_price_per_day) AS revenue

FROM rental_details rd

JOIN books b
ON rd.book_id = b.id

JOIN rentals r
ON rd.rental_id = r.id

WHERE r.status = N'đã trả'

GROUP BY b.category

ORDER BY revenue DESC;

