       STRING_AGG(CONCAT('MT', rd.book_id, '(SL:', rd.quantity, ')'), ', ') AS bookInfo
FROM rentals r
LEFT JOIN rental_details rd ON r.id = rd.rental_id
GROUP BY r.id, r.customer_id, r.staff_id, r.rent_date, r.return_date, r.total_money
ORDER BY r.id DESC;

