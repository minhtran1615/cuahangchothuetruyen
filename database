GO

USE ql_thuvien;
GO

CREATE TABLE books (
    id INT IDENTITY(1,1) PRIMARY KEY,
    title NVARCHAR(200) NOT NULL,
    author NVARCHAR(100),
    category NVARCHAR(100),
    quantity INT DEFAULT 0
);
GO
ALTER TABLE books
ADD rent_price_per_day INT DEFAULT 0;

ALTER TABLE books
ADD status NVARCHAR(50) DEFAULT N'Còn';


CREATE TABLE customers (
    id INT IDENTITY(1,1) PRIMARY KEY,
    fullname NVARCHAR(100) NOT NULL,
    phone VARCHAR(20),
    address NVARCHAR(200)
);
GO
EXEC sp_rename 'customers.address', 'registerDate', 'COLUMN';
ALTER TABLE customers
ALTER COLUMN registerDate DATE;


CREATE TABLE users (
    id INT IDENTITY(1,1) PRIMARY KEY,
    username VARCHAR(50) UNIQUE,
    password VARCHAR(50),
    role VARCHAR(20) DEFAULT 'staff'
);
GO

ALTER TABLE users
DROP CONSTRAINT DF__users__role__5070F446;
GO

ALTER TABLE users
DROP COLUMN role;
GO

ALTER TABLE users
ADD full_name NVARCHAR(100);
GO


CREATE TABLE rentals (
    id INT IDENTITY(1,1) PRIMARY KEY,
    customer_id INT NOT NULL,
    rent_date DATE NOT NULL,
    return_date DATE,
    status NVARCHAR(50) DEFAULT N'dang_thue',

    CONSTRAINT FK_rentals_customers FOREIGN KEY (customer_id)
    REFERENCES customers(id)
);
GO
ALTER TABLE rentals
ADD staff_id INT;
GO

ALTER TABLE rentals
ADD total_money DECIMAL(18,2) DEFAULT 0;
GO

ALTER TABLE rentals
ADD CONSTRAINT FK_rentals_users
FOREIGN KEY (staff_id) REFERENCES users(id);
GO

ALTER TABLE rentals
ALTER COLUMN staff_id INT NOT NULL;
GO


CREATE TABLE rental_details (
    id INT IDENTITY(1,1) PRIMARY KEY,
    rental_id INT NOT NULL,
    book_id INT NOT NULL,
    quantity INT DEFAULT 1,

    CONSTRAINT FK_rentaldetails_rentals FOREIGN KEY (rental_id)
    REFERENCES rentals(id),

    CONSTRAINT FK_rentaldetails_books FOREIGN KEY (book_id)
    REFERENCES books(id)
);
